        "app_py_code = \"\"\"\n",
        "import streamlit as st\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import plotly.express as px\n",
        "\n",
        "st.set_page_config(layout='wide', page_title='ACCT 3343 - Financial Screen App')\n",
        "\n",
        "# App title and overview\n",
        "st.title('📊 ACCT 3343: Within-Industry Financial Analysis App')\n",
        "st.markdown(\n",
        "    \"This interactive platform allows users to apply modern financial filters across a universe of **500+ companies**. \"\n",
        "    \"Define and isolate potential **SELL** (high accruals risk, low distress margin) and **BUY** (strong value and high cash return) prospects using course-specific metrics.\"\n",
        ")\n",
        "\n",
        "@st.cache_data\n",
        "def load_data():\n",
        "    df = pd.read_csv('universe.csv')\n",
        "    # Drop pitch company example\n",
        "    df = df[df['Ticker'] != 'TSLA']\n",
        "\n",
        "    # Calculate industry-relative rankings (within-industry percentiles)\n",
        "    if 'Sloan_Accruals' in df.columns:\n",
        "        df['Accruals_Percentile'] = df.groupby('Sector')['Sloan_Accruals'].rank(pct=True)\n",
        "    if 'Altman_Z' in df.columns:\n",
        "        df['Z_Percentile'] = df.groupby('Sector')['Altman_Z'].rank(pct=True)\n",
        "    if 'ROA' in df.columns:\n",
        "        df['ROA_Percentile'] = df.groupby('Sector')['ROA'].rank(pct=True)\n",
        "\n",
        "    return df\n",
        "\n",
        "try:\n",
        "    df_universe = load_data()\n",
        "except Exception as e:\n",
        "    st.error(f\"Error loading universe.csv: {e}\")\n",
        "    st.stop()\n",
        "\n",
        "# Sidebar Section\n",
        "st.sidebar.header('⚙️ Filter Controls')\n",
        "\n",
        "# Sector Filter\n",
        "all_sectors = sorted(df_universe['Sector'].dropna().unique().tolist())\n",
        "selected_sectors = st.sidebar.multiselect('Select Sectors to Include', all_sectors, default=all_sectors)\n",
        "filtered_df = df_universe[df_universe['Sector'].isin(selected_sectors)]\n",
        "\n",
        "# 1. SELL Candidates criteria (Sloan Accruals & Altman Z distress)\n",
        "st.sidebar.subheader('🚨 SELL Filter Settings')\n",
