        "import pandas as pd\n",
        "import yfinance as yf\n",
        "import numpy as np\n",
        "import urllib.request\n",
        "\n",
        "print(\"Fetching S&P 500 constituent table from Wikipedia using a User-Agent header...\")\n",
        "try:\n",
        "    # Using urllib with a user-agent header to bypass HTTP 403 Forbidden blocker\n",
        "    req = urllib.request.Request(\n",
        "        'https://en.wikipedia.org/wiki/List_of_S%26P_500_companies',\n",
        "        headers={'User-Agent': 'Mozilla/5.0'}\n",
        "    )\n",
        "    with urllib.request.urlopen(req) as response:\n",
        "        html = response.read()\n",
        "\n",
        "    sp500_df = pd.read_html(html)[0]\n",
        "    tickers = sp500_df['Symbol'].str.replace('.', '-', regex=False).tolist()\n",
        "    sectors = dict(zip(sp500_df['Symbol'].str.replace('.', '-', regex=False), sp500_df['GICS Sector']))\n",
        "    names = dict(zip(sp500_df['Symbol'].str.replace('.', '-', regex=False), sp500_df['Security']))\n",
        "except Exception as e:\n",
        "    print(f\"Error reading Wikipedia: {e}. Falling back to standard list.\")\n",
        "    tickers = ['AAPL', 'MSFT', 'GOOGL', 'AMZN', 'META', 'BRK-B', 'LLY', 'AVGO', 'V', 'JPM']\n",
        "    sectors = {t: 'Technology' for t in tickers}\n",
        "    names = {t: t for t in tickers}\n",
        "\n",
        "print(f\"Retrieved {len(tickers)} tickers. Pulling financial data via yfinance...\")\n",
        "\n",
        "data_rows = []\n",
        "\n",
        "# Process the tickers sequentially\n",
        "for i, ticker in enumerate(tickers[:510]):  # Pull up to 510 tickers to cross 500+ target\n",
        "    if i % 50 == 0:\n",
        "        print(f\"Processing ticker {i+1}/{len(tickers[:510])}...\")\n",
        "    try:\n",
        "        t = yf.Ticker(ticker)\n",
        "        info = t.info\n",
        "\n",
        "        bs = t.balance_sheet\n",
        "        is_df = t.financials\n",
        "        cf = t.cashflow\n",
        "\n",
        "        if bs.empty or is_df.empty:\n",
        "            continue\n",
        "\n",
        "        total_assets = bs.loc['Total Assets'].iloc[0] if 'Total Assets' in bs.index else np.nan\n",
        "        current_assets = bs.loc['Current Assets'].iloc[0] if 'Current Assets' in bs.index else np.nan\n",
        "        current_liab = bs.loc['Current Liabilities'].iloc[0] if 'Current Liabilities' in bs.index else np.nan\n",
        "        retained_earnings = bs.loc['Retained Earnings'].iloc[0] if 'Retained Earnings' in bs.index else np.nan\n",
        "        ebit = is_df.loc['EBIT'].iloc[0] if 'EBIT' in is_df.index else np.nan\n",
        "        total_liab = bs.loc['Total Liabilities Net Minority Interest'].iloc[0] if 'Total Liabilities Net Minority Interest' in bs.index else (bs.loc['Total Liabilities'].iloc[0] if 'Total Liabilities' in bs.index else np.nan)\n",
        "        revenue = is_df.loc['Total Revenue'].iloc[0] if 'Total Revenue' in is_df.index else np.nan\n",
        "        net_income = is_df.loc['Net Income'].iloc[0] if 'Net Income' in is_df.index else np.nan\n",
        "\n",
        "        ocf = cf.loc['Operating Cash Flow'].iloc[0] if (not cf.empty and 'Operating Cash Flow' in cf.index) else np.nan\n",
        "        mkt_cap = info.get('marketCap', np.nan)\n",
        "        working_cap = current_assets - current_liab\n",
        "\n",
        "        data_rows.append({\n",
        "            'Ticker': ticker,\n",
        "            'Company': names.get(ticker, ticker),\n",
        "            'Sector': sectors.get(ticker, 'Unknown'),\n",
        "            'TotalAssets': total_assets,\n",
        "            'WorkingCapital': working_cap,\n",
        "            'RetainedEarnings': retained_earnings,\n",
        "            'EBIT': ebit,\n",
        "            'MarketCap': mkt_cap,\n",
        "            'TotalLiabilities': total_liab,\n",
        "            'Revenue': revenue,\n",
        "            'NetIncome': net_income,\n",
        "            'OperatingCashFlow': ocf,\n",
        "            'CurrentRatio': info.get('currentRatio', np.nan),\n",
        "            'DebtToEquity': info.get('debtToEquity', np.nan),\n",
        "            'ROA': info.get('returnOnAssets', np.nan)\n",
        "        })\n",
        "    except Exception as e:\n",
        "        continue\n",
        "\n",
        "df_universe = pd.DataFrame(data_rows)\n",
        "\n",
        "# Compute Altman Z-Score\n",
        "df_universe['X1'] = df_universe['WorkingCapital'] / df_universe['TotalAssets']\n",
        "df_universe['X2'] = df_universe['RetainedEarnings'] / df_universe['TotalAssets']\n",
        "df_universe['X3'] = df_universe['EBIT'] / df_universe['TotalAssets']\n",
        "df_universe['X4'] = df_universe['MarketCap'] / df_universe['TotalLiabilities']\n",
        "df_universe['X5'] = df_universe['Revenue'] / df_universe['TotalAssets']\n",
        "\n",
        "df_universe['Altman_Z'] = (1.2 * df_universe['X1'] +\n",
        "                           1.4 * df_universe['X2'] +\n",
        "                           3.3 * df_universe['X3'] +\n",
        "                           0.6 * df_universe['X4'] +\n",
        "                           0.999 * df_universe['X5'])\n",
        "\n",
        "# Compute Sloan Accruals\n",
        "df_universe['Sloan_Accruals'] = (df_universe['NetIncome'] - df_universe['OperatingCashFlow']) / df_universe['TotalAssets']\n",
        "\n",
        "df_universe.to_csv('universe.csv', index=False)\n",
        "print(f\"Successfully fetched and saved {len(df_universe)} companies into universe.csv!\")"
      ],
